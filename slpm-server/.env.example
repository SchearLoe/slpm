# 复制本文件为 .env 并按需修改

# 数据库（PostgreSQL 16 本地）
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/wenxibuddy?schema=public"

# JWT —— 生产环境务必改成随机长字符串（可用 openssl rand -hex 32 生成）
JWT_SECRET="change-me-to-a-long-random-string"
JWT_EXPIRES_IN="7d"

# 服务
PORT=8080
NODE_ENV=development
CLIENT_ORIGIN="http://localhost:3000"

# AI（P1-4）—— API Key 加密密钥，务必随机长字符串（可用 openssl rand -hex 32 生成）
AI_ENCRYPTION_KEY="change-me-to-a-long-random-string"
