# 复制本文件为 .env 并按需修改

# 数据库（PostgreSQL 16 本地）
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/wenxibuddy?schema=public"

# JWT —— 生产环境务必改成随机长字符串（可用 openssl rand -hex 32 生成）
JWT_SECRET="change-me-to-a-long-random-string"
JWT_EXPIRES_IN="7d"

# 服务
PORT=8080
NODE_ENV=development
CLIENT_ORIGIN="http://localhost:3000"

# AI（P1-4）—— API Key 加密密钥，务必随机长字符串（可用 openssl rand -hex 32 生成）
AI_ENCRYPTION_KEY="change-me-to-a-long-random-string"

# 文件存储根目录（可选，默认 uploads）
UPLOAD_DIR=uploads

# 超级管理员初始化（P4-1，可选）
# 启动时若不存在 system_admin 会自动创建：
#  - 配置了下面两个变量 → 用指定账号
#  - 未配置 → admin@slpm.local + 随机密码（打印到控制台）
INITIAL_ADMIN_EMAIL=admin@slpm.local
INITIAL_ADMIN_PASSWORD=
