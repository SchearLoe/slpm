# 复制本文件为 .env 并按需修改

# 数据库（PostgreSQL 16 本地）
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/slpm?schema=public"

# JWT —— 生产环境强制 required（缺失则拒绝启动）；开发环境未配置会用兜底默认值并警告。
# 生产务必改成随机长字符串：openssl rand -hex 32
JWT_SECRET="change-me-to-a-long-random-string"
JWT_EXPIRES_IN="7d"

# 服务
PORT=8080
NODE_ENV=development            # 生产环境设为 production
CLIENT_ORIGIN="http://localhost:3000"

# AI（P1-4）—— API Key 加密密钥，务必随机长字符串（可用 openssl rand -hex 32 生成）
AI_ENCRYPTION_KEY="change-me-to-a-long-random-string"

# 文件存储根目录（可选，默认 uploads）
UPLOAD_DIR=uploads

# 超级管理员初始化（P4-1，可选）
# 启动时若不存在 system_admin 会自动创建：
#  - 配置了下面两个变量 → 用指定账号
#  - 未配置 → admin@slpm.local + 随机密码（写入 .admin-initial-password 文件，不再打印到 stdout）
INITIAL_ADMIN_EMAIL=admin@slpm.local
INITIAL_ADMIN_PASSWORD=

# ============ P7 安全增强（可选） ============

# 忘记密码：是否在 API 响应中返回重置链接（仅供开发/测试）。
# 默认 false（生产环境应接入邮件服务投递重置链接）。
# 历史漏洞：旧实现依赖 NODE_ENV=development 判断，生产误配 NODE_ENV 会泄露重置 token。
ENABLE_DEV_RESET_LINK=false

# 反向代理信任（部署在 nginx/CDN/负载均衡后必须设为 true，否则限流与审计 IP 失效）。
# 直连部署保持默认 false。
TRUST_PROXY=false
